# Project that runs (and pays for) the query jobs.
BQ_BILLING_PROJECT=my-gcp-project
# Comma-separated allowlist of `project.dataset`. Nothing else is reachable.
BQ_ALLOWED_DATASETS=bigquery-public-data.thelook_ecommerce
BQ_LOCATION=US

# Guardrails
BQ_MAX_BYTES_BILLED=1000000000
BQ_MAX_ROWS=1000
BQ_JOB_TIMEOUT_S=60
BQ_SAMPLE_ROWS=3
BQ_PRICE_PER_TIB_USD=6.25
